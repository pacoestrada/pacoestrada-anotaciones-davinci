{ Tools = ordered() { Template = MacroOperator { NameSet = true, Inputs = ordered() {Input1 = InstanceInput {SourceOp = "Zone", Source = "Center", Name = "Posicion de la zona"}, Input2 = InstanceInput {SourceOp = "Zone", Source = "Width", Name = "Ancho"}, Input3 = InstanceInput {SourceOp = "Zone", Source = "Height", Name = "Alto"}, Input4 = InstanceInput {SourceOp = "Zone", Source = "Angle", Name = "Giro"}, Input5 = InstanceInput {SourceOp = "Zone", Source = "SoftEdge", Name = "Suavidad del borde"}, Input6 = InstanceInput {SourceOp = "BlurZone", Source = "XBlurSize", Name = "Intensidad del desenfoque"}, MainInput1 = InstanceInput {SourceOp = "BlurZone", Source = "Input", Name = "Imagen"}}, Outputs = { MainOutput1 = InstanceOutput { SourceOp = "BlurZone", Source = "Output" } }, ViewInfo = GroupInfo { Pos = {0, 0} }, Tools = ordered() {Zone = RectangleMask { NameSet = true, Inputs = {MaskWidth = Input { Value = 1920 }, MaskHeight = Input { Value = 1080 }, PixelAspect = Input { Value = {1, 1} }, ClippingMode = Input { Value = FuID { "None" } }, Center = Input { Value = {0.5, 0.5} }, Width = Input { Value = 0.32 }, Height = Input { Value = 0.08 }, Solid = Input { Value = 1 }, SoftEdge = Input { Value = 0.003 }, Invert = Input { Value = 0 }},  }, BlurZone = Blur { NameSet = true, Inputs = {EffectMask = Input { SourceOp = "Zone", Source = "Mask" }, XBlurSize = Input { Value = 25 }, YBlurSize = Input { Value = 25 }, LockXY = Input { Value = 1 }, Filter = Input { Value = FuID { "Gaussian" } }},  }} } }, ActiveTool = "Template" }
